# dependencies
node_modules/

# build output
dist/
target/
src-tauri/target/

# editors / OS
.DS_Store
*.log

# Local model cache, if a developer points it at the repo. Anchored to the root: the
# bare `models/` this used to say matched every directory of that name at any depth,
# which silently kept `crates/models/` and `src/features/models/` out of the repository
# — a clone could not build, and nothing in the local checkout ever hinted at it.
/models/

# API credentials. Never committed.
.env
.env.local
freesound.json

# Design notes, decision records and the implementation plan. Kept on this machine,
# not published: they describe how the thing was built, which is not what someone
# cloning it needs.
docs/
